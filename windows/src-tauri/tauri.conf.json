{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceBridge",
  "version": "0.1.0",
  "identifier": "com.voicebridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceBridge",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQTRGQzAzNDFBQzNBQTEKUldTaE9xeEJBL3lrMEhocm9TR2dIQ1F1VENmY2ZOMkp3MG82WC9JMFhXRFBaNW1Ya0psWFJqTGEK",
      "endpoints": [
        "https://github.com/czczccc/VoiceBridge/releases/download/windows-testing/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
